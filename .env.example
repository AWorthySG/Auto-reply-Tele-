# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to run admin commands.
# Find yours by messaging @userinfobot.
ADMIN_IDS=

# Anthropic API key for AI-powered replies (optional for rule-only mode)
ANTHROPIC_API_KEY=
# Model used for AI replies. Haiku is fast + cheap and well-suited to short replies.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Max tokens per AI reply
ANTHROPIC_MAX_TOKENS=400

# SQLite database path (local dev). Swapped for Supabase/Postgres at deploy time.
DATABASE_PATH=bot.db
