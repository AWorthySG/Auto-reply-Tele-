# From https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# Local session file name (autoreply.session). Keep it private.
SESSION_NAME=autoreply

REPLY_MESSAGE=Hi, I am away at the moment. I will reply as soon as I can.

# Minimum gap between auto-replies in the same chat
COOLDOWN_MINUTES=60

# true = only auto-reply to people not in your contacts
SKIP_CONTACTS=false
