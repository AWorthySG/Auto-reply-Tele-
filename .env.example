# Telegram API credentials.
# Get these from https://my.telegram.org -> "API development tools".
# These belong to YOUR personal account; keep them secret.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Optional: your phone number in international format (e.g. +6591234567).
# If omitted, login.py will prompt for it interactively.
TELEGRAM_PHONE=

# Name of the Telethon session file (without extension). A "<name>.session"
# file is created on first login and keeps you logged in afterwards.
SESSION_NAME=autoreply

# Path to the YAML config file (defaults to config.yaml).
CONFIG_PATH=config.yaml
